# 0 "rpi-adin1110-overlay.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "rpi-adin1110-overlay.dts"






/dts-v1/;
/plugin/;

# 1 "include/dt-bindings/interrupt-controller/irq.h" 1
# 11 "rpi-adin1110-overlay.dts" 2

&spidev0 {
 status = "disabled";
};

&spidev1 {
 status = "disabled";
};

&spi0 {
 #address-cells = <1>;
 #size-cells = <0>;
 status = "okay";

 ethernet@0 {
  compatible = "adi,adin1110";
  reg = <0>;
  spi-max-frequency = <25000000>;

  adi,spi-crc;
  #address-cells = <1>;
  #size-cells = <0>;

  interrupt-parent = <&gpio>;
  interrupts = <18 8>;
  mac-address = [ CA 2F B7 10 23 64 ];

  phy@0 {
   compatible = "ethernet-phy-id0283.bc91";
   reg = <0x0>;
  };
 };
};

&gpio {
 gpio_overrides: gpio_overrides {
  pin-13-reset-high {
   pins = "gpio27";
   function = "gpio_out";
   bias-pull-up;
   output-high;
   export;
  };
 };
};
